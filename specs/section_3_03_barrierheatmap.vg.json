{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "description": "Reasons adults who did not take part give, by age group, 2025",
    "data": {
        "url": "data/barriers_by_age.csv"
    },
    "width": {
        "step": 62
    },
    "height": {
        "step": 34
    },
    "encoding": {
        "x": {
            "field": "age_group",
            "type": "ordinal",
            "sort": [
                "All adults",
                "15-17",
                "18-24",
                "25-34",
                "35-44",
                "45-54",
                "55-64",
                "65+"
            ],
            "title": null,
            "axis": {
                "orient": "top",
                "labelAngle": 0,
                "ticks": false,
                "domain": false
            }
        },
        "y": {
            "field": "barrier",
            "type": "nominal",
            "sort": [
                "Poor health or injury",
                "Getting older",
                "Too lazy",
                "Disability",
                "Don't like sport or exercise",
                "Not enough time",
                "Not a priority",
                "Nobody to do it with",
                "Can't afford it",
                "Fear of injury"
            ],
            "title": null,
            "axis": {
                "ticks": false,
                "domain": false,
                "labelLimit": 220
            }
        }
    },
    "layer": [
        {
            "mark": {
                "type": "rect",
                "stroke": "white",
                "strokeWidth": 2
            },
            "encoding": {
                "color": {
                    "field": "share",
                    "type": "quantitative",
                    "scale": {
                        "scheme": "tealblues",
                        "domain": [
                            0,
                            0.5
                        ]
                    },
                    "legend": {
                        "title": "Share of non-participants",
                        "format": ".0%",
                        "orient": "bottom"
                    }
                },
                "tooltip": [
                    {
                        "field": "barrier",
                        "type": "nominal",
                        "title": "Reason"
                    },
                    {
                        "field": "age_group",
                        "type": "nominal",
                        "title": "Age group"
                    },
                    {
                        "field": "share",
                        "type": "quantitative",
                        "format": ".0%",
                        "title": "Share giving this reason"
                    },
                    {
                        "field": "people",
                        "type": "quantitative",
                        "format": ",",
                        "title": "People (estimate)"
                    }
                ]
            }
        }
        
    ]
}