{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "data": {
        "url": "data/tile_grid_state_rank.csv"
    },
    "facet": {
        "row": {
            "field": "period",
            "type": "nominal",
            "title": null,
            "sort": [
                "2013-14 (ABS)",
                "2025 (AusPlay)"
            ]
        }
    },
    "spec": {
        "width": 560,
        "height": 220,
        "encoding": {
            "x": {
                "field": "col",
                "type": "ordinal",
                "axis": null
            },
            "y": {
                "field": "row",
                "type": "ordinal",
                "axis": null
            }
        },
        "layer": [
            {
                "mark": {
                    "type": "rect",
                    "stroke": "white",
                    "strokeWidth": 3
                },
                "encoding": {
                    "color": {
                        "field": "rank",
                        "type": "quantitative",
                        "scale": {
                            "scheme": "tealblues",
                            "reverse": true,
                            "domain": [
                                1,
                                8
                            ]
                        },
                        "legend": {
                            "title": "Rank (1 = highest)"
                        }
                    },
                    "tooltip": [
                        {
                            "field": "state",
                            "type": "nominal"
                        },
                        {
                            "field": "rate",
                            "type": "quantitative",
                            "format": ".1f",
                            "title": "Participation (%)"
                        },
                        {
                            "field": "rank",
                            "type": "quantitative"
                        }
                    ]
                }
            },
            {
                "mark": {
                    "type": "text",
                    "fontWeight": "bold",
                    "dy": -6
                },
                "encoding": {
                    "text": {
                        "field": "state",
                        "type": "nominal"
                    },
                    "color": {
                        "condition": {
                            "test": "datum.rank <= 4",
                            "value": "white"
                        },
                        "value": "black"
                    }
                }
            },
            {
                "mark": {
                    "type": "text",
                    "dy": 10,
                    "fontSize": 11
                },
                "encoding": {
                    "text": {
                        "field": "rank",
                        "type": "quantitative"
                    },
                    "color": {
                        "condition": {
                            "test": "datum.rank <= 4",
                            "value": "white"
                        },
                        "value": "black"
                    }
                }
            }
        ]
    }
}